---
import BaseLayout from '../../layouts/BaseLayout.astro';

const candidates = [
  {
    name: 'Dell Latitude 5420',
    image: 'https://i.dell.com/is/image/DellContent//content/dam/ss2/product-images/dell-client-products/notebooks/latitude-notebooks/14-5420/global-spi/ng/notebook-latitude-5420-nt-relsize-500-ng.psd?fmt=jpg&hei=191&wid=500',
    imageAlt: 'Dell Latitude 5420 の製品写真',
    credit: 'Dell',
    source: 'https://www.dell.com/support/product-details/ja-jp/product/latitude-5420-laptop',
    cpu: 'Core i7-1185G7 / 4C8T',
    memory: '2 SO-DIMM / 最大64GB',
    role: '管理・ブラウザ・CLI作業',
    note: '増設性が強み。状態とバッテリーを重視。'
  },
  {
    name: 'ThinkPad T14 Gen 2',
    image: 'https://p3-ofp.static.pub/fes/cms/2022/06/13/c70uc8tdc9jq9bo4x41dphqfqusowi992268.png?height=584&width=584',
    imageAlt: 'Lenovo ThinkPad T14 Gen 2 AMD の製品写真',
    credit: 'Lenovo',
    source: 'https://www.lenovo.com/jp/ja/p/laptops/thinkpad/thinkpad-t-series/22tpt14t4a1/22tpt14t4a1',
    cpu: 'Ryzen 7 PRO 5850Uなら 8C16T',
    memory: 'オンボード＋SO-DIMM',
    role: 'サブ機兼軽サーバー候補',
    note: 'AMD 5850U構成は別格。構成違いに注意。'
  },
  {
    name: 'HP EliteBook 830 G8',
    image: 'https://jp.ext.hp.com/content/dam/jp-ext-hp-com/jp/ja/ec/notebooks/business/elitebook_830_g8/images/view2_mobile.jpg',
    imageAlt: 'HP EliteBook 830 G8 の製品写真',
    credit: '日本HP',
    source: 'https://jp.ext.hp.com/notebooks/business/elitebook_830_g8/',
    cpu: '第11世代 Core i5 / i7 / 4C8T',
    memory: '2 SO-DIMM / 最大64GB',
    role: '持ち運び・管理端末',
    note: '小型でも増設しやすい点を評価。'
  },
  {
    name: 'Surface Pro 7',
    image: 'https://support.microsoft.com/ja-jp/surface/media/4202347e-f4f7-0d30-87f2-966649fb1bef.png',
    imageAlt: 'Microsoft Surface Pro 7 の製品画像',
    credit: 'Microsoft',
    source: 'https://support.microsoft.com/ja-jp/surface/models/surface-pro-7-specs-and-features',
    cpu: 'Core i7-1065G7 / 4C8T',
    memory: '最大16GB構成',
    role: '軽量な遠隔管理端末',
    note: '携帯性は強いが、メモリ増設前提では選ばない。'
  },
  {
    name: 'Surface Book 3',
    image: 'https://support.microsoft.com/ja-jp/surface/media/d1fe3e2e-9261-fdba-6c36-81fe9dec4603.png',
    imageAlt: 'Microsoft Surface Book 3 の製品画像',
    credit: 'Microsoft',
    source: 'https://support.microsoft.com/ja-jp/surface/models/surface-book-3-specs-and-features',
    cpu: 'Core i7-1065G7 / 4C8T',
    memory: '32GB構成あり',
    role: 'GPUも使う作業端末',
    note: '性能は魅力。ただし中古構造リスクを織り込む。'
  }
];
---

<BaseLayout
  title="中古ビジネスノート活用ガイド｜自宅サーバーPC図鑑"
  description="24時間サーバー本命とは分けて、管理・持ち運び・AI作業用の中古ビジネスノートを選ぶ基準と購入前チェック項目を整理します。"
>
  <header class="page-hero">
    <p class="kicker">USED BUSINESS LAPTOP / SUB MACHINE</p>
    <h1>本命サーバーと、管理ノートは分けて選ぶ。</h1>
    <p>4コアの中古ノートを、8コア以上を狙う24時間サーバー本命と同列にはしません。外出先からの管理、Claude Code / Gemini系CLI、ブラウザ作業、予備機としての価値を別軸で見ます。</p>
  </header>

  <section class="section">
    <div class="section-head">
      <p class="kicker">01 / ROLE</p>
      <div>
        <h2>役割が違えば、正解も変わる。</h2>
        <p>サーバー本命は並列性能・メモリ・消費電力・安定性。中古ノートは持ち運び、増設性、修理しやすさ、バッテリー、中古リスクを優先します。</p>
      </div>
    </div>
    <div class="guide-steps">
      <article class="guide-step"><div><h2>24時間サーバー本命</h2><p>8C16T以上、32GB、NVMe、有線LANを基本線に、完成総額10万円以内を優先。常時稼働の消費電力と冷却を重視します。</p></div></article>
      <article class="guide-step"><div><h2>管理・持ち運び・サブ機</h2><p>4C8Tでも用途次第で十分。ただしRAM増設可否、USB-C、映像出力、バッテリー、BIOSロック、Autopilot残存を購入前に確認します。</p></div></article>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="kicker">02 / CANDIDATES</p>
      <div>
        <h2>中古ノート候補は、写真つきで見る。</h2>
        <p>型番が似ていても筐体や構成は違います。写真を必須にし、外観と公式仕様を同時に確認できるようにします。</p>
      </div>
    </div>
    <div class="used-laptop-grid">
      {candidates.map((pc) => (
        <article class="used-laptop-card">
          <figure>
            <img src={pc.image} alt={pc.imageAlt} width="584" height="438" loading="lazy" decoding="async" />
            <figcaption>画像: <a href={pc.source} target="_blank" rel="noopener noreferrer">{pc.credit}</a></figcaption>
          </figure>
          <div class="used-laptop-copy">
            <h3>{pc.name}</h3>
            <dl>
              <div><dt>CPU例</dt><dd>{pc.cpu}</dd></div>
              <div><dt>メモリ</dt><dd>{pc.memory}</dd></div>
              <div><dt>向く役割</dt><dd>{pc.role}</dd></div>
              <div><dt>見方</dt><dd>{pc.note}</dd></div>
            </dl>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="dark-panel">
    <div class="section-head">
      <p class="kicker">03 / SURFACE BOOK 3</p>
      <div>
        <h2>Surface Book 3は、性能ではなく中古リスクで保留。</h2>
        <p>13.5インチのCore i7構成には32GB RAM＋GeForce GTX 1650 Max-Q搭載SKUがあります。一方で、タブレット側とキーボードベース側のバッテリー、着脱機構、GPUを持つキーボードベースなど構造が複雑です。中古では故障時の負担を一般的な法人ノートより大きく見積もります。</p>
      </div>
    </div>
    <div class="axis-list">
      <div class="axis-row"><span>01</span><strong>32GB構成</strong><small>ブラウザ・AIツール同時利用では有利</small></div>
      <div class="axis-row"><span>02</span><strong>GPU搭載</strong><small>13.5型i7の一部SKUはGTX 1650 Max-Q</small></div>
      <div class="axis-row"><span>03</span><strong>複雑な構造</strong><small>中古故障リスクは高めに評価</small></div>
      <div class="axis-row"><span>04</span><strong>修理性</strong><small>一般的な法人ノートより不利になりやすい</small></div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <p class="kicker">04 / CHECKLIST</p>
      <div><h2>中古は、スペック表より先に確認する項目がある。</h2><p>安く見えても、管理ロック・バッテリー・ACアダプター・RAM構成で実質コストが変わります。</p></div>
    </div>
    <div class="guide-steps">
      <article class="guide-step"><div><h2>BIOS / UEFI</h2><p>管理者・システム・SSDパスワードが未設定か確認。解除できない個体は避けます。</p></div></article>
      <article class="guide-step"><div><h2>組織管理</h2><p>Windows Autopilotや会社・学校アカウントへの強制登録が残っていないか確認します。</p></div></article>
      <article class="guide-step"><div><h2>SSD / バッテリー</h2><p>SSDの健康状態、総書き込み量、バッテリー劣化・膨張の有無を確認します。</p></div></article>
      <article class="guide-step"><div><h2>端子 / 付属品</h2><p>USB-C充電・映像出力、液晶、ACアダプターの容量、メモリ枚数と空きスロット、販売店保証を確認します。</p></div></article>
    </div>
  </section>

  <section class="section prose">
    <h2>公式仕様を確認する</h2>
    <p>中古出品は同じ型番でも構成が違います。購入候補が決まったら、出品ページだけでなくメーカー公式仕様も合わせて確認します。</p>
    <ul>
      <li><a href="https://www.dell.com/support/manuals/en-us/latitude-5420-laptop/5420_sp14_setupspecs/memory" target="_blank" rel="noopener noreferrer">Dell Latitude 5420 メモリ仕様</a></li>
      <li><a href="https://psref.lenovo.com/WDProduct/ThinkPad/ThinkPad_T14_Gen_2_AMD?tab=spec" target="_blank" rel="noopener noreferrer">Lenovo ThinkPad T14 Gen 2 AMD PSREF</a></li>
      <li><a href="https://h20195.www2.hp.com/v2/GetDocument.aspx?docname=c07044240" target="_blank" rel="noopener noreferrer">HP EliteBook 830 G8 仕様書</a></li>
      <li><a href="https://support.microsoft.com/ja-jp/surface/models/surface-pro-7-specs-and-features" target="_blank" rel="noopener noreferrer">Microsoft Surface Pro 7 仕様</a></li>
      <li><a href="https://support.microsoft.com/ja-jp/surface/models/surface-book-3-specs-and-features" target="_blank" rel="noopener noreferrer">Microsoft Surface Book 3 仕様</a></li>
      <li><a href="https://learn.microsoft.com/ja-jp/surface/surface-book-gpu-overview" target="_blank" rel="noopener noreferrer">Microsoft Surface Book 3 GPU / SKU一覧</a></li>
    </ul>
    <p class="note-box">写真は掲載必須です。現在はメーカー公式画像を使用し、実機を入手した機種は順次自前写真へ置き換えます。</p>
  </section>
</BaseLayout>
