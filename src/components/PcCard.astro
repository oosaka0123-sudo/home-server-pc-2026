---
import type { Pc } from '../lib/pcs';
import { budgetLabel, dataLabel, formatYen } from '../lib/pcs';
const { pc, index = 1 } = Astro.props as { pc: Pc; index?: number };
const base = import.meta.env.BASE_URL;
---
<article class="pc-card" data-reveal>
  <div class="pc-card-top">
    <span class="index-number">{String(index).padStart(2, '0')}</span>
    <div class:list={['status-chip', pc.budgetStatus]}>{budgetLabel(pc.budgetStatus)}</div>
  </div>
  <p class="pc-maker">{pc.maker} / {pc.condition}</p>
  <h3>{pc.name}</h3>
  <p class="pc-cpu">{pc.cpu}</p>
  <div class="spec-strip">
    <span><strong>{pc.cores}</strong> CORE</span>
    <span><strong>{pc.memoryGb}</strong> GB</span>
    <span><strong>{pc.storageGb >= 1000 ? pc.storageGb / 1000 + 'TB' : pc.storageGb + 'GB'}</strong> SSD</span>
  </div>
  <div class="pc-price">
    <small>完成総額</small>
    <strong>{formatYen(pc.totalJpy)}</strong>
  </div>
  <div class="pc-meta">
    <span>{dataLabel(pc.dataStatus)}</span>
    <span>確認 {pc.checkedAt}</span>
  </div>
  <a class="text-link" href={`${base}pcs/${pc.slug}/`}>詳細を見る <span aria-hidden="true">↗</span></a>
</article>
