---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AffiliateRuntime from '../components/AffiliateRuntime.astro';

const {
  title = '自宅サーバーPC図鑑',
  description = '完成総額10万円以内を軸に、24時間365日動かすミニPC・中古PCを実測・総額・電気代で比較します。'
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${import.meta.env.BASE_URL}og-default.png`, Astro.site);
const siteName = '自宅サーバーPC図鑑';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  url: new URL(import.meta.env.BASE_URL, Astro.site).toString(),
  description,
  inLanguage: 'ja-JP'
};
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#121510" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}site.webmanifest`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="自宅サーバーPC図鑑｜完成総額10万円以内の24時間運用PC比較" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="自宅サーバーPC図鑑｜完成総額10万円以内の24時間運用PC比較" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <AffiliateRuntime />
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const items = document.querySelectorAll('[data-reveal]');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        items.forEach((item) => observer.observe(item));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((item) => item.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
